[Unit]
Description=BC250 qualified 1700 MHz GPU profile with thermal fallback
Wants=bc250-cu-live-manager.service
After=bc250-cu-live-manager.service
Before=bc250-ai.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/bc250-gpu-guard.py 1700
ExecStopPost=/usr/bin/python3 /usr/local/libexec/bc250-gpu-clock.py restore
Restart=no
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
